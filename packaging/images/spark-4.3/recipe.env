# The Kumo Spark 4.3 engine image, as ../lib/build-image.sh reads it.
IMAGE_NAME=kumo-spark-4.3
TITLE="Spark 4.3"
ENGINE=spark
ENGINE_VERSION=4.3
# Ubuntu 26.04 LTS, as the Kubernetes image (docs/design/09-spark.md section 7).
RECIPE_BASE_URL=https://cloud-images.ubuntu.com/resolute/current
RECIPE_BASE_IMAGE=resolute-server-cloudimg-amd64.img
# 8G virtual: Spark, the JDK and the S3 jars unpacked with room to spare, and a
# node's root overlay is never smaller than this (min_disk_gb in the manifest).
RECIPE_DISK_SIZE=8G
BUILD_MEMORY_MIB=4096
BUILD_CPUS=2

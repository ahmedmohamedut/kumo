# The Kumo Kubernetes 1.37 engine image, as ../lib/build-image.sh reads it.
IMAGE_NAME=kumo-kubernetes-1.37
TITLE="Kubernetes 1.37"
ENGINE=kubernetes
ENGINE_VERSION=1.37
# Ubuntu 26.04 LTS: kernel 7.0 for Cilium's datapath, and support to 2031
# (docs/design/08-kubernetes.md section 7). The Postgres recipe stays on 24.04.
RECIPE_BASE_URL=https://cloud-images.ubuntu.com/resolute/current
RECIPE_BASE_IMAGE=resolute-server-cloudimg-amd64.img
# 8G virtual: room for every pre-pulled image unpacked, and a node's root
# overlay is never smaller than this (min_disk_gb in the manifest).
RECIPE_DISK_SIZE=8G
BUILD_MEMORY_MIB=4096
BUILD_CPUS=2

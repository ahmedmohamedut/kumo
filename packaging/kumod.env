# Kumo configuration. Every setting is a KUMO_* environment variable, and every
# one of them is documented in docs/design/00-architecture.md section 5.
#
# This file is marked as configuration, so an upgrade keeps your edits and
# leaves the new default beside them as a .rpmnew / .dpkg-dist file.
#
# Restart after editing:   systemctl restart kumod

# Where the console and the API listen. Bind to a LAN address or to 127.0.0.1
# and put a reverse proxy in front if this node is reachable from anywhere you
# do not control.
KUMO_LISTEN=:8080

# The SQLite database, the signing key and the storage pools all live here. The
# systemd unit owns it as StateDirectory, so leave it under /var/lib unless you
# also change the unit.
KUMO_DATA_DIR=/var/lib/kumo

# ---------------------------------------------------------------------------
# This release serves plain HTTP, so the refresh cookie cannot be Secure.
#
# A Secure cookie is only stored by a browser over HTTPS. Leaving this true on
# an HTTP install does not harden anything — it stops the cookie being stored at
# all, and every operator is signed out on reload. TLS is not in this release
# (it is an open item on the v0.1 roadmap), so the honest setting is false.
#
# Set it back to true the moment Kumo is behind TLS, whether that is a reverse
# proxy you terminate HTTPS on or Kumo's own certificates once they land.
# Until then, treat the console as a LAN service.
# ---------------------------------------------------------------------------
KUMO_COOKIE_SECURE=false

# The libvirt socket. The default is the system daemon's.
# KUMO_LIBVIRT_URI=unix:///var/run/libvirt/libvirt-sock

# The address range of the VPC a fresh node creates. Change it before the first
# start if your LAN already owns 192.168.100.0/24 — it must not overlap a route
# the host already has.
# KUMO_DEFAULT_VPC_CIDR=192.168.100.0/24

# Host memory kept out of the pool Kumo will allocate from, in MiB.
# KUMO_MEMORY_RESERVE_MIB=1024

# vCPUs offered per host vCPU. 4 is generous; set it to 1 to stop overcommitting.
# KUMO_VCPU_OVERCOMMIT=4

# debug | info | warn | error
# KUMO_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Object storage (S3-compatible, backed by a RustFS you run yourself). Off by
# default. See docs/design/06-object-storage.md.
#
# Put the RustFS admin keys in the credentials file and make it private:
#   printf 'access_key=...\nsecret_key=...\n' > /var/lib/kumo/s3.credentials
#   chown kumo:kumo /var/lib/kumo/s3.credentials
#   chmod 600 /var/lib/kumo/s3.credentials
# then check with `kumod doctor`.
# ---------------------------------------------------------------------------
# KUMO_OBJECTSTORE=rustfs
# KUMO_S3_ENDPOINT=http://127.0.0.1:9000
# The address browsers reach RustFS at, when it is not the endpoint above.
# KUMO_S3_PUBLIC_URL=http://kumo.example:9000
# The address you open the console at; without it browsers refuse uploads.
# KUMO_S3_CORS_ORIGINS=http://kumo.example:8080
# KUMO_S3_CREDENTIALS_FILE=/var/lib/kumo/s3.credentials
# KUMO_S3_PRESIGN_TTL=15m

# ---------------------------------------------------------------------------
# Databases (managed Postgres). On by default: it needs no server Kumo does
# not ship. See docs/design/07-databases.md.
#
# What it does need is an engine image -- a golden qcow2 with Postgres already
# installed, built once with packaging/images/postgres-18/build.sh and
# imported like any other image, with kind=engine. Until then the Databases
# pages explain the import and `kumod doctor` warns; nothing else is affected.
#
# Turn the module off to hide the pages and answer 503 on /api/v1/rds/*:
# KUMO_DATABASES=off
#
# How often a creating or running DB instance is dialed to see whether the
# engine answers, and how long a create waits before it is marked failed.
# KUMO_DB_PROBE_INTERVAL=10s
# KUMO_DB_READY_TIMEOUT=10m
